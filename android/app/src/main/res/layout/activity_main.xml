<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="GSMS SMS v1.0\nGHSS Utror Swat" android:textSize="24sp" android:textStyle="bold"/>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="Server stopped" android:textSize="18sp"/>
    <TextView android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="PC gateway address" android:textIsSelectable="true"/>
    <TextView android:id="@+id/token" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Pairing token" android:textIsSelectable="true"/>
    <Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="Start SMS Gateway"/>
    <Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Stop SMS Gateway"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:text="Keep this phone on the same Wi-Fi network as the PC. SMS is sent through SIM 1."/>
</LinearLayout>
