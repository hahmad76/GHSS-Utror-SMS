<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="GSMS SMS v1.0\nGHSS Utror Swat"
            android:textSize="26sp" android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ANDROID-ONLY EDITION — PC connectivity is reserved for Version 2."
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Import your school CSV to begin. SMS will be sent through SIM 1."
            android:textSize="16sp" android:textStyle="bold" />

        <Button
            android:id="@+id/gatewaySettings"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="GATEWAY SETTINGS / TOKEN" />

        <Button
            android:id="@+id/importCsv"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="IMPORT STUDENTS / STAFF CSV" />

        <TextView
            android:id="@+id/databaseInfo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No CSV imported yet."
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="SMS audience"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/audienceSpinner"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <Spinner
            android:id="@+id/filterSpinner"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/manualRecipients"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="For manual SMS: 03XXXXXXXXX, 03XXXXXXXXX"
            android:inputType="phone|textMultiLine"
            android:minLines="2" android:gravity="top"
            android:visibility="gone" />

        <TextView
            android:id="@+id/recipientCount"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Recipients: 0"
            android:textSize="18sp" android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="SMS message"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/message"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Type your message here..."
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="6" android:gravity="top" />

        <TextView
            android:id="@+id/counter"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Message length: 0 characters" />

        <Button
            android:id="@+id/send"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="SEND BULK SMS THROUGH SIM 1" />

        <Button
            android:id="@+id/clear"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="CLEAR MESSAGE" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="CSV columns supported: Student/Staff Name, Father/Guardian, Class, Section, Mobile Number, Category/Role. Column names may be written in common variations. Keep SIM 1 active. SMS charges depend on your mobile package."
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
